{
  "compilerOptions": {
    "target": "ES2020",

    "module": "Node16",
    "moduleResolution": "Node16",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",

    "resolveJsonModule": true,

    "types": ["node"]
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}